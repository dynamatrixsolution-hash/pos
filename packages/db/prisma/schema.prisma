datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Business {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logo      String?
  phone     String?
  email     String?
  address   String?
  currency  String    @default("USD")
  taxConfig Json? // { taxName: "VAT", rate: 15 }
  settings  Json? // Custom metadata settings
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  subscription           Subscription?
  branches               Branch[]
  users                  User[]
  categories             Category[]
  subcategories          Subcategory[]
  brands                 Brand[]
  units                  Unit[]
  products               Product[]
  customers              Customer[]
  suppliers              Supplier[]
  sales                  Sale[]
  purchases              Purchase[]
  payments               Payment[]
  saleReturns            SaleReturn[]
  purchaseReturns        PurchaseReturn[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  incomeCategories       IncomeCategory[]
  incomes                Income[]
  stockTransfers         StockTransfer[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  openingStocks          OpeningStock[]
  fiscalYears            FiscalYear[]
  fiscalYearSequences    FiscalYearInvoiceSequence[]
  creditNotes            CreditNote[]
  debitNotes             DebitNote[]
  cbmsSyncQueues         CbmsSyncQueue[]
  branchMemberships      UserBranchMembership[]
  auditEvents            AuditEvent[]
  paymentAllocations     PaymentAllocation[]
  paymentReversals       PaymentReversal[]
  refunds                Refund[]
  stockMovements         StockMovement[]
  outboxEvents           OutboxEvent[]
  floors                 Floor[]
  restaurantTables       RestaurantTable[]
  tableSessions          TableSession[]
  menus                  Menu[]
  menuSections           MenuSection[]
  menuItems              MenuItem[]
  modifierGroups         ModifierGroup[]
  modifierOptions        ModifierOption[]
  menuItemModifierGroups MenuItemModifierGroup[]
  restaurantOrders       RestaurantOrder[]
  orderRounds            OrderRound[]
  orderLines             OrderLine[]
  kitchenStations        KitchenStation[]
  stationRoutes          StationRoute[]
  kitchenTickets         KitchenTicket[]
  kitchenTicketLines     KitchenTicketLine[]
  recipeVersions         RecipeVersion[]
  recipeIngredients      RecipeIngredient[]
  consumptionPostings    ConsumptionPosting[]
  roomTypes              RoomType[]
  rooms                  Room[]
  reservations           Reservation[]
  reservationGuests      ReservationGuest[]
  stays                  Stay[]
  roomAllocations        RoomAllocation[]
  housekeepingTasks          HousekeepingTask[]
  maintenanceTickets         MaintenanceTicket[]
  guestFolios                GuestFolio[]
  roomNightCharges           RoomNightCharge[]
  folioEntries               FolioEntry[]
  folioSettlementAllocations FolioSettlementAllocation[]
  qrLocations                QrLocation[]
  guestAccessGrants          GuestAccessGrant[]
  guestSessions              GuestSession[]
  serviceRequests            ServiceRequest[]
  propertyFeatureFlags       PropertyFeatureFlag[]
  printJobs                  PrintJob[]
  offlineSyncBatches         OfflineSyncBatch[]
  pilotDailyReconciliations  PilotDailyReconciliation[]
}

model Subscription {
  id          String   @id @default(uuid())
  businessId  String   @unique
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        String   @default("FREE") // FREE, BASIC, PREMIUM, ENTERPRISE
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate   DateTime @default(now())
  endDate     DateTime
  userLimit   Int      @default(3)
  branchLimit Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, id])
}

model Branch {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  address    String?
  isMain     Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  users                User[]
  productStocks        ProductStock[]
  batches              Batch[]
  sales                Sale[]
  purchases            Purchase[]
  expenses             Expense[]
  incomes              Income[]
  stockTransfersSource StockTransfer[]             @relation("SourceBranch")
  stockTransfersTarget StockTransfer[]             @relation("TargetBranch")
  customers            Customer[]
  openingStocks        OpeningStock[]
  payments             Payment[]
  fiscalYearSequences  FiscalYearInvoiceSequence[]
  creditNotes          CreditNote[]
  debitNotes           DebitNote[]
  userMemberships      UserBranchMembership[]
  auditEvents          AuditEvent[]
  refunds              Refund[]
  stockMovements       StockMovement[]
  floors               Floor[]
  restaurantTables     RestaurantTable[]
  tableSessions        TableSession[]
  menus                Menu[]
  restaurantOrders     RestaurantOrder[]
  kitchenStations      KitchenStation[]
  kitchenTickets       KitchenTicket[]
  consumptionPostings  ConsumptionPosting[]
  roomTypes            RoomType[]
  rooms                Room[]
  reservations         Reservation[]
  stays                Stay[]
  roomAllocations      RoomAllocation[]
  housekeepingTasks          HousekeepingTask[]
  maintenanceTickets         MaintenanceTicket[]
  guestFolios                GuestFolio[]
  roomNightCharges           RoomNightCharge[]
  folioEntries               FolioEntry[]
  folioSettlementAllocations FolioSettlementAllocation[]
  qrLocations                QrLocation[]
  guestAccessGrants          GuestAccessGrant[]
  guestSessions              GuestSession[]
  serviceRequests            ServiceRequest[]
  propertyFeatureFlags       PropertyFeatureFlag[]
  printJobs                  PrintJob[]
  offlineSyncBatches         OfflineSyncBatch[]
  pilotDailyReconciliations  PilotDailyReconciliation[]

  @@unique([businessId, id])
}

model User {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("CASHIER") // SUPER_ADMIN, OWNER, MANAGER, CASHIER, ACCOUNTANT, STOREKEEPER, SALESPERSON, DELIVERY
  phone           String?
  isActive        Boolean   @default(true)
  allowedDeviceId String?
  deviceName      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  sales                   Sale[]
  purchases               Purchase[]
  expenses                Expense[]
  incomes                 Income[]
  auditLogs               AuditLog[]
  enteredOpeningStocks    OpeningStock[]         @relation("EnteredBy")
  approvedOpeningStocks   OpeningStock[]         @relation("ApprovedBy")
  requestedTransfers      StockTransfer[]        @relation("RequestedTransfers")
  approvedTransfers       StockTransfer[]        @relation("ApprovedTransfers")
  receivedTransfers       StockTransfer[]        @relation("ReceivedTransfers")
  payments                Payment[]
  firstPrintedSales       Sale[]                 @relation("FirstPrintedBy")
  lastPrintedSales        Sale[]                 @relation("LastPrintedBy")
  cancelledSales          Sale[]                 @relation("CancelledSales")
  creditNotes             CreditNote[]
  debitNotes              DebitNote[]
  branchMemberships       UserBranchMembership[]
  auditEvents             AuditEvent[]
  paymentAllocations      PaymentAllocation[]
  paymentReversals        PaymentReversal[]
  refunds                 Refund[]
  stockMovements          StockMovement[]
  openedTableSessions     TableSession[]         @relation("SessionOpenedBy")
  closedTableSessions     TableSession[]         @relation("SessionClosedBy")
  createdRestaurantOrders RestaurantOrder[]      @relation("OrderCreatedBy")
  submittedOrderRounds    OrderRound[]           @relation("RoundSubmittedBy")
  postedConsumptions          ConsumptionPosting[]   @relation("ConsumptionPostedBy")
  createdReservations         Reservation[]          @relation("ReservationCreatedBy")
  checkedInStays              Stay[]                 @relation("StayCheckedInBy")
  checkedOutStays             Stay[]                 @relation("StayCheckedOutBy")
  reportedMaintenanceTickets MaintenanceTicket[]    @relation("MaintenanceReportedBy")
  assignedMaintenanceTickets MaintenanceTicket[]    @relation("MaintenanceAssignedTo")
  resolvedMaintenanceTickets MaintenanceTicket[]    @relation("MaintenanceResolvedBy")
  assignedHousekeepingTasks   HousekeepingTask[]          @relation("HousekeepingAssignedTo")
  completedHousekeepingTasks  HousekeepingTask[]          @relation("HousekeepingCompletedBy")
  postedRoomNightCharges      RoomNightCharge[]           @relation("RoomNightChargePostedBy")
  postedFolioEntries          FolioEntry[]                @relation("FolioEntryPostedBy")
  allocatedFolioSettlements   FolioSettlementAllocation[] @relation("FolioSettlementAllocatedBy")
  createdQrLocations          QrLocation[]                @relation("QrLocationCreatedBy")
  revokedGuestAccessGrants    GuestAccessGrant[]          @relation("GuestAccessGrantRevokedBy")
  acknowledgedServiceRequests ServiceRequest[]            @relation("ServiceRequestAcknowledgedBy")
  resolvedServiceRequests     ServiceRequest[]            @relation("ServiceRequestResolvedBy")
  updatedFeatureFlags         PropertyFeatureFlag[]       @relation("FeatureFlagUpdatedBy")
  syncedOfflineBatches        OfflineSyncBatch[]          @relation("OfflineBatchSyncedBy")
  reconciledPilotAudits       PilotDailyReconciliation[]  @relation("PilotReconciledBy")

  @@unique([businessId, id])
}

model Category {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  products      Product[]
  stationRoutes StationRoute[]
  subcategories Subcategory[]

  @@unique([businessId, id])
}

model Brand {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  products Product[]

  @@unique([businessId, id])
}

model Subcategory {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  products Product[]

  @@unique([businessId, id])
}

model Unit {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  products Product[]

  @@unique([businessId, id])
}

model Product {
  id             String       @id @default(uuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitId         String?
  unit           Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name           String
  sku            String?
  barcode        String?
  description    String?
  costPrice      Decimal      @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal      @default(0) @db.Decimal(12, 2)
  wholesalePrice Decimal      @default(0) @db.Decimal(12, 2)
  alertQuantity  Int          @default(5)
  image          String?
  batchTracking  Boolean      @default(false)
  expiryTracking Boolean      @default(false)
  isVatItem      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  productStocks       ProductStock[]
  batches             Batch[]
  saleItems           SaleItem[]
  purchaseItems       PurchaseItem[]
  stockTransferItems  StockTransferItem[]
  openingStocks       OpeningStock[]
  creditNoteItems     CreditNoteItem[]
  debitNoteItems      DebitNoteItem[]
  stockMovements      StockMovement[]
  menuItems           MenuItem[]
  recipeIngredients   RecipeIngredient[]
  consumptionPostings ConsumptionPosting[]

  @@unique([businessId, id])
}

model ProductStock {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
}

model Batch {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  batchNumber       String
  quantity          Float     @default(0)
  costPrice         Decimal?  @db.Decimal(12, 2)
  sellingPrice      Decimal?  @db.Decimal(12, 2)
  expiryDate        DateTime?
  manufacturingDate DateTime?
  rackNumber        String?
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model Customer {
  id           String    @id @default(uuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name         String
  email        String?
  phone        String?
  address      String?
  customerType String    @default("RETAIL") // RETAIL, WHOLESALE
  creditLimit  Decimal   @default(0) @db.Decimal(12, 2)
  balance      Decimal   @default(0) @db.Decimal(12, 2) // Debt owed by customer to us
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sales    Sale[]
  ledgers  CustomerLedger[]
  payments Payment[]
  refunds  Refund[]

  @@unique([businessId, id])
}

model CustomerLedger {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String // SALE, PAYMENT, RETURN, ADJUSTMENT
  reference   String?
  debit       Decimal  @default(0) @db.Decimal(12, 2) // Amount customer owes us (increases balance)
  credit      Decimal  @default(0) @db.Decimal(12, 2) // Amount customer pays us (decreases balance)
  balance     Decimal  @default(0) @db.Decimal(12, 2) // Running balance
  description String?
  createdAt   DateTime @default(now())
}

model Supplier {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  balance     Decimal   @default(0) @db.Decimal(12, 2) // Debt we owe to supplier
  isImported  Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchases     Purchase[]
  ledgers       SupplierLedger[]
  openingStocks OpeningStock[]
  batches       Batch[]
  payments      Payment[]

  @@unique([businessId, id])
}

model SupplierLedger {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        String // PURCHASE, PAYMENT, RETURN, ADJUSTMENT
  reference   String?
  debit       Decimal  @default(0) @db.Decimal(12, 2) // What we paid supplier (decreases balance)
  credit      Decimal  @default(0) @db.Decimal(12, 2) // What we purchased from supplier (increases balance)
  balance     Decimal  @default(0) @db.Decimal(12, 2) // Running balance we owe
  description String?
  createdAt   DateTime @default(now())
}

model Sale {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String    @unique
  status        String    @default("COMPLETED") // COMPLETED, DRAFT, ON_HOLD, RETURNED
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  tax           Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus String    @default("PAID") // PAID, PARTIAL, UNPAID
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  saleItems          SaleItem[]
  payments           Payment[]
  saleReturns        SaleReturn[]
  paymentAllocations PaymentAllocation[]
  refunds            Refund[]
  fiscalYearId       String?
  fiscalYear         FiscalYear?         @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  isPrinted          Boolean             @default(false)
  printCount         Int                 @default(0)
  firstPrintedAt     DateTime?
  firstPrintedById   String?
  firstPrintedBy     User?               @relation("FirstPrintedBy", fields: [firstPrintedById], references: [id], onDelete: SetNull)
  lastPrintedAt      DateTime?
  lastPrintedById    String?
  lastPrintedBy      User?               @relation("LastPrintedBy", fields: [lastPrintedById], references: [id], onDelete: SetNull)
  isActive           Boolean             @default(true) // Is active (true) or cancelled/corrected (false)
  syncWithIrd        String              @default("PENDING") // PENDING, SYNCED, FAILED, RETRYING, REJECTED
  vatRefundAmount    Decimal             @default(0) @db.Decimal(12, 2)
  transactionId      String?
  correctedInvoiceId String?
  cancellationReason String?
  cancelledById      String?
  cancelledBy        User?               @relation("CancelledSales", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cbmsRequestId      String?
  cbmsResponseId     String?
  cbmsSyncTime       DateTime?
  cbmsError          String?
  cbmsRetryCount     Int                 @default(0)
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]
  cbmsSyncQueues     CbmsSyncQueue[]

  @@unique([businessId, id])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String?
  quantity    Float   @default(1)
  costPrice   Decimal @default(0) @db.Decimal(12, 2)
  price       Decimal @default(0) @db.Decimal(12, 2) // Selling price per unit after discount
  discount    Decimal @default(0) @db.Decimal(12, 2) // Unit-level discount
  tax         Decimal @default(0) @db.Decimal(12, 2) // Unit-level tax
  total       Decimal @default(0) @db.Decimal(12, 2) // quantity * price
}

model Purchase {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseNumber String    @unique
  invoiceNumber  String?
  status         String    @default("RECEIVED") // ORDERED, RECEIVED, CANCELLED
  subtotal       Decimal   @default(0) @db.Decimal(12, 2)
  discount       Decimal   @default(0) @db.Decimal(12, 2)
  tax            Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus  String    @default("PAID") // PAID, PARTIAL, UNPAID
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  purchaseItems      PurchaseItem[]
  payments           Payment[]
  purchaseReturns    PurchaseReturn[]
  paymentAllocations PaymentAllocation[]

  @@unique([businessId, id])
}

model PurchaseItem {
  id                String    @id @default(uuid())
  purchaseId        String
  purchase          Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber       String?
  expiryDate        DateTime?
  manufacturingDate DateTime?
  quantity          Float     @default(1)
  price             Decimal   @default(0) @db.Decimal(12, 2) // Buying price per unit
  total             Decimal   @default(0) @db.Decimal(12, 2)
}

model Payment {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchaseId    String?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId        String? // receivedBy or sentBy
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Decimal   @db.Decimal(12, 2)
  source        String    @default("LEGACY_UNVERIFIED")
  method        String    @default("CASH") // CASH, CARD, QR, BANK_TRANSFER, CREDIT
  reference     String? // Reference number
  receiptNumber String? // Receipt or voucher number
  remarks       String? // Notes/remarks
  type          String    @default("RECEIVED") // RECEIVED or SENT
  createdAt     DateTime  @default(now())

  allocations PaymentAllocation[]
  reversal    PaymentReversal?
  refunds     Refund[]

  @@unique([businessId, id])
}

// Responses commit atomically with business effects. Do not purge while clients may retry.
model RequestResult {
  id          String   @id @default(uuid())
  businessId  String
  operation   String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())

  @@unique([businessId, operation, key])
  @@unique([businessId, id])
}

model SaleReturn {
  id           String           @id @default(uuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleId       String
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnNumber String           @unique
  refundAmount Decimal          @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime         @default(now())
  items        SaleReturnItem[]

  @@unique([businessId, id])
}

model SaleReturnItem {
  id           String     @id @default(uuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  quantity     Float
  price        Decimal    @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
}

model PurchaseReturn {
  id           String               @id @default(uuid())
  businessId   String
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseId   String
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  returnNumber String               @unique
  refundAmount Decimal              @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime             @default(now())
  items        PurchaseReturnItem[]

  @@unique([businessId, id])
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String
  quantity         Float
  price            Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
}

model ExpenseCategory {
  id         String    @id @default(uuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
