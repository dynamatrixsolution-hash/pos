model MenuItemModifierGroup {
  id                    String        @id @default(uuid())
  businessId            String
  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItemId            String
  menuItem              MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId       String
  modifierGroup         ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  displayOrder          Int           @default(0)
  overrideMinSelections Int?
  overrideMaxSelections Int?
  createdAt             DateTime      @default(now())

  @@unique([businessId, id])
  @@unique([businessId, menuItemId, modifierGroupId])
  @@index([businessId, menuItemId])
  @@index([businessId, modifierGroupId])
}

model RestaurantOrder {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSessionId String?
  tableSession   TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderNumber    String
  orderType      String           @default("DINE_IN") // DINE_IN, TAKEAWAY, BAR_WALK_IN

  // Independent 3D Status Dimensions
  acceptanceStatus  String @default("PENDING") // PENDING, ACCEPTED, REJECTED
  fulfillmentStatus String @default("QUEUED") // QUEUED, PREPARING, READY, SERVED, CANCELLED
  settlementStatus  String @default("UNPAID") // UNPAID, PARTIAL, PAID, REFUNDED

  // Aggregated Monies (Decimal 12, 2)
  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal @default(0) @db.Decimal(12, 2)

  version     Int      @default(1) // Optimistic Concurrency Control
  createdById String?
  createdBy   User?    @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rounds         OrderRound[]
  orderLines     OrderLine[]
  kitchenTickets KitchenTicket[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, orderNumber])
  @@index([businessId, branchId, settlementStatus])
  @@index([businessId, tableSessionId])
  @@index([businessId, tableId])
  @@index([businessId, acceptanceStatus])
  @@index([businessId, fulfillmentStatus])
}

model OrderRound {
  id            String          @id @default(uuid())
  businessId    String
  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId       String
  order         RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roundNumber   Int             @default(1)
  status        String          @default("SUBMITTED") // PENDING, SUBMITTED, PREPARING, COMPLETED, CANCELLED
  submittedAt   DateTime        @default(now())
  submittedById String?
  submittedBy   User?           @relation("RoundSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lines          OrderLine[]
  kitchenTickets KitchenTicket[]

  @@unique([businessId, id])
  @@unique([businessId, orderId, roundNumber])
  @@index([businessId, orderId, roundNumber])
}

model OrderLine {
  id         String          @id @default(uuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderId    String
  order      RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roundId    String
  round      OrderRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  // Immutable Snapshots
  itemName         String
  basePrice        Decimal @db.Decimal(12, 2)
  quantity         Int     @default(1)
  appliedModifiers Json // Snapshot array: [{ modifierGroupId, groupName, optionId, optionName, priceDelta }]
  unitPrice        Decimal @db.Decimal(12, 2)
  taxRate          Decimal @default(0) @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  notes            String?

  // Independent 3D Line Statuses
  acceptanceStatus  String @default("PENDING") // PENDING, ACCEPTED, REJECTED
  fulfillmentStatus String @default("QUEUED") // QUEUED, PREPARING, READY, SERVED, CANCELLED
  settlementStatus  String @default("UNPAID") // UNPAID, PARTIAL, PAID, REFUNDED

  // Audit & Cancellation Provenance
  rejectionReason String?
  voidReason      String?
  auditEventId    String?

  version   Int      @default(1) // Optimistic Concurrency Control
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketLines KitchenTicketLine[]

  @@unique([businessId, id])
  @@index([businessId, orderId, roundId])
  @@index([businessId, fulfillmentStatus])
  @@index([businessId, settlementStatus])
  @@index([businessId, menuItemId])
}

// ==========================================
// Phase 4: Production Kitchen, Recipes & KDS
// ==========================================

model KitchenStation {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  code         String // e.g. "HOT", "COLD", "BAR", "GRILL"
  printerIp    String?
  printerPort  Int?     @default(9100)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routes    StationRoute[]
  tickets   KitchenTicket[]
  printJobs PrintJob[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, code])
  @@index([businessId, branchId, isActive])
}

model StationRoute {
  id         String         @id @default(uuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stationId  String
  station    KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([businessId, id])
  @@index([businessId, stationId])
  @@index([businessId, menuItemId])
  @@index([businessId, categoryId])
}

model KitchenTicket {
  id             String          @id @default(uuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stationId      String
  station        KitchenStation  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  orderId        String
  order          RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  roundId        String
  round          OrderRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  ticketNumber   String
  status         String          @default("QUEUED") // QUEUED, PREPARING, READY, SERVED, CANCELLED
  revisionNumber Int             @default(1)
  notes          String?
  printedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines     KitchenTicketLine[]
  printJobs PrintJob[]

  @@unique([businessId, id])
  @@unique([businessId, roundId, stationId])
  @@index([businessId, branchId, status])
  @@index([businessId, stationId, status])
  @@index([businessId, orderId])
}

model KitchenTicketLine {
  id                String        @id @default(uuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ticketId          String
  ticket            KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderLineId       String
  orderLine         OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  itemName          String
  quantity          Int           @default(1)
  modifiersSnapshot Json // [{ groupName, optionName }]
  dietaryAlerts     Json? // ["GLUTEN_FREE", "NO_NUTS", "VEGAN"]
  notes             String?
  status            String        @default("QUEUED") // QUEUED, PREPARING, READY, CANCELLED
  isWaste           Boolean       @default(false)
  wasteReason       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  consumptionPostings ConsumptionPosting[]

  @@unique([businessId, id])
  @@unique([businessId, ticketId, orderLineId])
  @@index([businessId, ticketId, status])
  @@index([businessId, orderLineId])
}

model RecipeVersion {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  versionNumber Int      @default(1)
  yieldQuantity Decimal  @default(1) @db.Decimal(12, 4)
  yieldUnit     String   @default("PORTION")
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ingredients         RecipeIngredient[]
  consumptionPostings ConsumptionPosting[]

  @@unique([businessId, id])
  @@unique([businessId, menuItemId, versionNumber])
  @@index([businessId, menuItemId, isActive])
}

model RecipeIngredient {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  productId       String // Raw inventory Product
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Decimal       @db.Decimal(12, 4)
  unit            String
  wastagePercent  Decimal       @default(0) @db.Decimal(5, 2)
  createdAt       DateTime      @default(now())

  @@unique([businessId, id])
  @@unique([businessId, recipeVersionId, productId])
  @@index([businessId, recipeVersionId])
  @@index([businessId, productId])
}

model ConsumptionPosting {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ticketLineId    String
  ticketLine      KitchenTicketLine @relation(fields: [ticketLineId], references: [id], onDelete: Cascade)
  recipeVersionId String?
  recipeVersion   RecipeVersion?    @relation(fields: [recipeVersionId], references: [id], onDelete: SetNull)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Decimal           @db.Decimal(12, 4)
  unit            String
  stockMovementId String?
  stockMovement   StockMovement?    @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  isWaste         Boolean           @default(false)
  reason          String?
  postedAt        DateTime          @default(now())
  postedById      String?
  postedBy        User?             @relation("ConsumptionPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  @@unique([businessId, id])
  @@index([businessId, ticketLineId])
  @@index([businessId, branchId, productId])
  @@index([businessId, stockMovementId])
}

// ==============================================================================
// PHASE 5: HOTEL INVENTORY, ROOMS & GUEST STAYS
// ==============================================================================

model RoomType {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  baseRate     Decimal  @default(0) @db.Decimal(12, 2)
  maxOccupancy Int      @default(2)
  amenities    Json?    // ["WIFI", "AC", "MINIBAR", "BALCONY", "OCEAN_VIEW"]
  images       Json?    // ["url1", "url2"]
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  reservations Reservation[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, code])
  @@index([businessId, branchId, isActive])
}

model Room {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomTypeId    String
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  floorId       String?
  floor         Floor?   @relation(fields: [floorId], references: [id], onDelete: SetNull)
  roomNumber    String
  capacity      Int      @default(2)
  status        String   @default("VACANT_CLEAN") // VACANT_CLEAN, VACANT_DIRTY, OCCUPIED_CLEAN, OCCUPIED_DIRTY, OUT_OF_SERVICE, MAINTENANCE
  currentStayId String?  // Scalar logical ID without @relation to preserve DAG acyclicity
  keyCardAlias  String?
  features      Json?    // ["CONNECTING", "ACCESSIBLE"]
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations       Reservation[]
  stays              Stay[]
  allocations        RoomAllocation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  roomNightCharges   RoomNightCharge[]
  qrLocations        QrLocation[]
  serviceRequests    ServiceRequest[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, roomNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, roomTypeId])
  @@index([businessId, floorId])
}

model Reservation {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservationNumber String
  guestName         String
  guestEmail        String?
  guestPhone        String?
  roomTypeId        String
  roomType          RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomId            String?
  room              Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  checkInDate       DateTime
  checkOutDate      DateTime
  status            String   @default("CONFIRMED") // CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  adults            Int      @default(1)
  children          Int      @default(0)
  ratePlan          String?  @default("STANDARD") // STANDARD, BED_AND_BREAKFAST, NON_REFUNDABLE
  nightlyRate       Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal  @default(0) @db.Decimal(12, 2)
  depositAmount     Decimal  @default(0) @db.Decimal(12, 2)
  specialRequests   String?
  notes             String?
  version           Int      @default(1)
  createdById       String?
  createdBy         User?    @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  guests      ReservationGuest[]
  stays       Stay[]
  allocations RoomAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, reservationNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, roomTypeId])
  @@index([businessId, roomId])
  @@index([businessId, checkInDate, checkOutDate])
}

model ReservationGuest {
  id            String      @id @default(uuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  idType        String?     // PASSPORT, CITIZENSHIP, DRIVING_LICENSE, NATIONAL_ID, OTHER
  idNumber      String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([businessId, id])
  @@index([businessId, reservationId])
}

model Stay {
  id               String       @id @default(uuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stayNumber       String
  reservationId    String?
  reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  roomId           String
  room             Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestName        String
  guestEmail       String?
  guestPhone       String?
  guestIdType      String?     // PASSPORT, CITIZENSHIP, DRIVING_LICENSE, NATIONAL_ID, OTHER
  guestIdNumber    String?
  checkInTime      DateTime     @default(now())
  checkOutTime     DateTime?
  expectedCheckOut DateTime
  status           String       @default("ACTIVE") // ACTIVE, COMPLETED, EXTENDED, TRANSFERRED
  ratePerNight     Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal      @default(0) @db.Decimal(12, 2)
  version          Int          @default(1)
  checkedInById    String?
  checkedInBy      User?        @relation("StayCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkedOutById   String?
  checkedOutBy     User?        @relation("StayCheckedOutBy", fields: [checkedOutById], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  allocations                RoomAllocation[]
  housekeepingTasks          HousekeepingTask[]
  folios                     GuestFolio[]
  roomNightCharges           RoomNightCharge[]
  folioEntries               FolioEntry[]
  folioSettlementAllocations FolioSettlementAllocation[]
  guestAccessGrants          GuestAccessGrant[]
  guestSessions              GuestSession[]
  serviceRequests            ServiceRequest[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, stayNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, roomId, status])
  @@index([businessId, reservationId])
}

model MaintenanceTicket {
  id              String    @id @default(uuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ticketNumber    String
  title           String
  description     String?
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CANCELLED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  startDate       DateTime  @default(now())
  endDate         DateTime?
  reportedById    String?
  reportedBy      User?     @relation("MaintenanceReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?     @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedById    String?
  resolvedBy      User?     @relation("MaintenanceResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  allocations RoomAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, ticketNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, roomId, status])
  @@index([businessId, assignedToId])
}

model RoomAllocation {
  id                  String             @id @default(uuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId            String
  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId              String
  room                Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId       String?
  reservation         Reservation?       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stayId              String?
  stay                Stay?              @relation(fields: [stayId], references: [id], onDelete: Cascade)
  maintenanceTicketId String?
  maintenanceTicket   MaintenanceTicket? @relation(fields: [maintenanceTicketId], references: [id], onDelete: Cascade)
  startDate           DateTime
  endDate             DateTime
  isBlocking          Boolean            @default(true)
  status              String             @default("CONFIRMED") // CONFIRMED, CHECKED_IN, MAINTENANCE, COMPLETED, CANCELLED
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([businessId, id])
  @@index([businessId, roomId, startDate, endDate])
  @@index([businessId, branchId, status])
  @@index([businessId, reservationId])
  @@index([businessId, stayId])
  @@index([businessId, maintenanceTicketId])
}

model HousekeepingTask {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stayId        String?
  stay          Stay?     @relation(fields: [stayId], references: [id], onDelete: SetNull)
  taskType      String    @default("DAILY_CLEANING") // CHECK_OUT_CLEANING, DAILY_CLEANING, DEEP_CLEANING, INSPECTION, TURNDOWN
  status        String    @default("DIRTY") // DIRTY, IN_PROGRESS, CLEAN, INSPECTED
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedToId  String?
  assignedTo    User?     @relation("HousekeepingAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  scheduledDate DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("HousekeepingCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([businessId, id])
  @@index([businessId, branchId, status])
  @@index([businessId, roomId, status])
  @@index([businessId, assignedToId])
}


// ==============================================================================
// PHASE 6: GUEST FOLIOS & CROSS-MODULE COMBINED SETTLEMENT
// ==============================================================================

model GuestFolio {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stayId        String
  stay          Stay      @relation(fields: [stayId], references: [id], onDelete: Cascade)
  folioNumber   String
  windowName    String    @default("PRIMARY") // PRIMARY, COMPANY, PERSONAL, INCIDENTALS
  guestName     String
  status        String    @default("OPEN") // OPEN, SETTLING, CLOSED, VOID
  chargesTotal  Decimal   @default(0) @db.Decimal(12, 2)
  creditsTotal  Decimal   @default(0) @db.Decimal(12, 2)
  paymentsTotal Decimal   @default(0) @db.Decimal(12, 2)
  balance       Decimal   @default(0) @db.Decimal(12, 2)
  lockedAt      DateTime?
  closedAt      DateTime?
  notes         String?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roomNightCharges RoomNightCharge[]
  entries          FolioEntry[]
  settlements      FolioSettlementAllocation[]

  @@unique([businessId, id])
  @@unique([businessId, branchId, folioNumber])
  @@unique([businessId, stayId, windowName])
  @@index([businessId, stayId, status])
  @@index([businessId, branchId, status])
}

model RoomNightCharge {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stayId      String
  stay        Stay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  folioId     String
  folio       GuestFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chargeDate  DateTime
  ratePlan    String?    @default("STANDARD")
  baseRate    Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)
  status      String     @default("POSTED") // POSTED, REVERSED
  postedById  String?
  postedBy    User?      @relation("RoomNightChargePostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  postedAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, stayId, chargeDate])
  @@index([businessId, folioId])
  @@index([businessId, branchId, chargeDate])
}

model FolioEntry {
  id                      String     @id @default(uuid())
  businessId              String
  business                Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  folioId                 String
  folio                   GuestFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  stayId                  String
  stay                    Stay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  entryNumber             String
  sourceType              String     // ROOM_NIGHT, RESTAURANT_ORDER, MINIBAR, LAUNDRY, SPA, DEPOSIT, ADJUSTMENT, REFUND
  sourceId                String
  postingKind             String     // CHARGE, RECEIVABLE_TRANSFER, CREDIT_ADJUSTMENT, DEPOSIT_APPLICATION, REVERSAL
  category                String     @default("OTHER") // ROOM, DINING, MINIBAR, LAUNDRY, SPA, DEPOSIT, OTHER
  description             String
  amount                  Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount               Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount             Decimal    @default(0) @db.Decimal(12, 2)
  direction               String     @default("DEBIT") // DEBIT (adds to balance), CREDIT (reduces balance)
  isRevenueRecognizedHere Boolean    @default(true)    // false for RECEIVABLE_TRANSFER from RestaurantOrder
  reversedEntryId         String?                      // Scalar logical ID to avoid self-referencing cycle in DR DAG
  metadata                Json?
  postedById              String?
  postedBy                User?      @relation("FolioEntryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  postedAt                DateTime   @default(now())
  createdAt               DateTime   @default(now())

  @@unique([businessId, id])
  @@unique([businessId, sourceType, sourceId, postingKind])
  @@index([businessId, folioId, postedAt])
  @@index([businessId, stayId, category])
  @@index([businessId, sourceType, sourceId])
}

model FolioSettlementAllocation {
  id            String     @id @default(uuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  folioId       String
  folio         GuestFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  stayId        String
  stay          Stay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  paymentId     String?    // Optional scalar reference to Payment ledger entry
  paymentMethod String     @default("CASH") // CASH, CARD, QR, BANK_TRANSFER, DEPOSIT
  amount        Decimal    @default(0) @db.Decimal(12, 2)
  reference     String?
  status        String     @default("APPLIED") // APPLIED, REVERSED, REFUNDED
  notes         String?
  allocatedById String?
  allocatedBy   User?      @relation("FolioSettlementAllocatedBy", fields: [allocatedById], references: [id], onDelete: SetNull)
  allocatedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@unique([businessId, id])
  @@index([businessId, folioId])
  @@index([businessId, stayId])
}

// ==============================================================================
// PHASE 7: GUEST SELF-SERVICE PORTAL & LOCATION QR SYSTEM
// ==============================================================================

model QrLocation {
  id            String           @id @default(uuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  publicCode    String           @unique
  locationType  String           // ROOM, TABLE
  roomId        String?
  room          Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tableId       String?
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label         String
  isActive      Boolean          @default(true)
  rotationCount Int              @default(1)
  metadata      Json?
  createdById   String?
  createdBy     User?            @relation("QrLocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  grants          GuestAccessGrant[]
  sessions        GuestSession[]
  serviceRequests ServiceRequest[]

  @@unique([businessId, id])
  @@unique([businessId, roomId])
  @@unique([businessId, tableId])
  @@index([businessId, branchId, locationType, isActive])
}

model GuestAccessGrant {
  id               String        @id @default(uuid())
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrLocationId     String
  qrLocation       QrLocation    @relation(fields: [qrLocationId], references: [id], onDelete: Cascade)
  grantType        String        // STAY_VERIFIED, TABLE_OPEN
  stayId           String?
  stay             Stay?         @relation(fields: [stayId], references: [id], onDelete: Cascade)
  tableSessionId   String?
  tableSession     TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  grantCodeHash    String        @unique
  scopes           Json          // ["MENU_BROWSE", "ORDER_INITIATE", "SERVICE_REQUEST", "BILL_VIEW", "CHECKOUT_REQUEST"]
  guestDisplayName String?
  status           String        @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  revokedById      String?
  revokedBy        User?         @relation("GuestAccessGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions        GuestSession[]
  serviceRequests ServiceRequest[]

  @@unique([businessId, id])
  @@index([businessId, stayId, status])
  @@index([businessId, tableSessionId, status])
  @@index([businessId, qrLocationId, status])
}

model GuestSession {
  id                String           @id @default(uuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrLocationId      String
  qrLocation        QrLocation       @relation(fields: [qrLocationId], references: [id], onDelete: Cascade)
  grantId           String
  grant             GuestAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  stayId            String?
  stay              Stay?            @relation(fields: [stayId], references: [id], onDelete: Cascade)
  tableSessionId    String?
  tableSession      TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  sessionTokenHash  String           @unique
  deviceFingerprint String?
  status            String           @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt         DateTime
  lastActiveAt      DateTime         @default(now())
  revokedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  serviceRequests ServiceRequest[]

  @@unique([businessId, id])
  @@index([businessId, stayId, status])
  @@index([businessId, tableSessionId, status])
  @@index([businessId, grantId, status])
}

model ServiceRequest {
  id               String            @id @default(uuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrLocationId     String
  qrLocation       QrLocation        @relation(fields: [qrLocationId], references: [id], onDelete: Cascade)
  grantId          String?
  grant            GuestAccessGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  guestSessionId   String?
  guestSession     GuestSession?     @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  stayId           String?
  stay             Stay?             @relation(fields: [stayId], references: [id], onDelete: SetNull)
  tableSessionId   String?
  tableSession     TableSession?     @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  roomId           String?
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  tableId          String?
  table            RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  requestNumber    String
  requestType      String            // WAITER_CALL, WATER_REFILL, BILL_REQUEST, EXTRA_TOWELS, HOUSEKEEPING, ROOM_AMENITIES, CHECKOUT_REQUEST, OTHER
  category         String            @default("RESTAURANT") // RESTAURANT, HOUSEKEEPING, FRONT_DESK, CONCIERGE
  priority         String            @default("NORMAL") // NORMAL, HIGH, URGENT
  status           String            @default("OPEN") // OPEN, ACKNOWLEDGED, IN_PROGRESS, COMPLETED, CANCELLED
  notes            String?
  idempotencyKey   String?
  requestedAt      DateTime          @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?             @relation("ServiceRequestAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?             @relation("ServiceRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes  String?
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, branchId, requestNumber])
  @@index([businessId, branchId, status, requestedAt])
  @@index([businessId, qrLocationId, requestType, requestedAt])
  @@index([businessId, stayId, status])
  @@index([businessId, tableSessionId, status])
}


// ==========================================
// Phase 8: Operational Readiness, Hardware Rehearsals & Pilot Rollout
// ==========================================

model PropertyFeatureFlag {
  id                      String   @id @default(uuid())
  businessId              String
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  hotelEnabled            Boolean  @default(true)
  restaurantEnabled       Boolean  @default(true)
  kdsEnabled              Boolean  @default(true)
  guestQrEnabled          Boolean  @default(true)
  folioBridgeEnabled      Boolean  @default(true)
  offlineDraftSyncEnabled Boolean  @default(true)
  printerFailoverEnabled  Boolean  @default(true)
  pilotMode               Boolean  @default(false)
  metadata                Json?
  updatedById             String?
  updatedBy               User?    @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, branchId])
  @@index([businessId, branchId])
}

model PrintJob {
  id                String          @id @default(uuid())
  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stationId         String?
  station           KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  ticketId          String?
  ticket            KitchenTicket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  jobNumber         String
  jobType           String          // KOT_58MM, RECEIPT_80MM, FOLIO_INVOICE, CASH_DRAWER_PULSE, TEST_PAGE
  printerWidthMm    Int             @default(80)
  targetPrinterIp   String?
  targetPrinterPort Int             @default(9100)
  fallbackStationId String?         // Scalar station ID to preserve DAG acyclicity
  routedStationId   String?         // Scalar station ID that actually printed after failover
  cashDrawerPulse   Boolean         @default(false)
  escPosPayload     String
  status            String          @default("QUEUED") // QUEUED, PRINTED, FAILED, REDIRECTED_TO_BACKUP, CANCELLED
  attempts          Int             @default(0)
  lastError         String?
  idempotencyKey    String?
  printedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([businessId, id])
  @@unique([businessId, branchId, jobNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, stationId, status])
}

model OfflineSyncBatch {
  id              String   @id @default(uuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terminalId      String
  batchKey        String
  operationsCount Int      @default(1)
  appliedCount    Int      @default(0)
  status          String   @default("COMPLETED") // COMPLETED, PARTIAL, CONFLICT
  payload         Json?
  results         Json?
  syncedById      String?
  syncedBy        User?    @relation("OfflineBatchSyncedBy", fields: [syncedById], references: [id], onDelete: SetNull)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([businessId, id])
  @@unique([businessId, branchId, batchKey])
  @@index([businessId, branchId, syncedAt])
}

model PilotDailyReconciliation {
  id                    String   @id @default(uuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId              String
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  businessDate          DateTime
  expectedCashTotal     Decimal  @default(0) @db.Decimal(12, 2)
  declaredCashTotal     Decimal  @default(0) @db.Decimal(12, 2)
  cashVariance          Decimal  @default(0) @db.Decimal(12, 2)
  retailSalesTotal      Decimal  @default(0) @db.Decimal(12, 2)
  restaurantOrdersTotal Decimal  @default(0) @db.Decimal(12, 2)
  folioSettlementsTotal Decimal  @default(0) @db.Decimal(12, 2)
  status                String   @default("BALANCED") // BALANCED, DISCREPANCY_FLAGGED, APPROVED
  notes                 String?
  reconciledById        String?
  reconciledBy          User?    @relation("PilotReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  reconciledAt          DateTime @default(now())
  createdAt             DateTime @default(now())

  @@unique([businessId, id])
  @@unique([businessId, branchId, businessDate])
  @@index([businessId, branchId, status])
}
